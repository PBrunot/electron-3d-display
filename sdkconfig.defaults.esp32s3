# Waveshare ESP32-S3-LCD-1.3 (see boards/WS-ESP32-S3-LCD-1-3.json): 16 MB external flash,
# 8 MB octal PSRAM. Auto-appended by ESP-IDF's CMake build after sdkconfig.defaults for
# the esp32s3 target only (file name IS the mechanism -- ESP-IDF looks for
# "sdkconfig.defaults.$IDF_TARGET" automatically, see sdkconfig.defaults's header
# comment) -- never applies to the CYD's plain esp32 build.
#
# The espidf framework doesn't read the board manifest's Arduino-only "psram_type"/
# "psram_size"/"partitions" keys (confirmed by reading espressif32's builder/main.py --
# that board.json data only feeds the arduino framework's memory_type autodetection), so
# flash size and PSRAM need to be pinned here explicitly or they silently stay off.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Without CONFIG_SPIRAM=y, this board's 8MB octal PSRAM is never initialized -- any data
# meant to live there (the ~450KB orbital_slice.cpp plane-slice scratch, EXT_RAM-attributed
# buffers) falls back into internal DRAM (320KB total) instead, overflowing dram0_0_seg by
# well over 1MB at link time. Values below are this board's actual verified-working PSRAM
# pin/mode config (copied from a real menuconfig run against this board, not guessed).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
