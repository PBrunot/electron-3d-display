# CYD (ESP32-2432S028R): plain ESP32-D0WD-V3, 4MB flash, no PSRAM.
# Filename IS the mechanism: ESP-IDF's CMake build auto-appends
# "sdkconfig.defaults.$IDF_TARGET" after the base sdkconfig.defaults, so this file (target
# "esp32") overrides that file's S3-oriented settings (16MB flash, PSRAM) for this board's
# build only -- see sdkconfig.defaults's header comment for the history here (this file was
# previously named sdkconfig.defaults.CYD, which ESP-IDF never actually looks for, so none
# of this took effect until the rename).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
# Literal "partitions.csv", NOT "partitions_cyd.csv" -- PlatformIO's espidf integration copies
# whatever `board_build.partitions` (platformio.ini) points to into the build tree under this
# exact name regardless of the source file's own name (see sdkconfig.defaults's identical
# "partitions.csv" for board_build.partitions=partitions_16M.csv on the S3 env).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
